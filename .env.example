# Copy to .env and adjust. .env is gitignored.

# Host port the broker is published on (the Nicla connects to <this machine's LAN IP>:<port>).
MQTT_PUBLISH_PORT=1883

LOG_LEVEL=INFO

# Recognition (used from M4 on)
YUNET_MODEL=/models/face_detection_yunet_2023mar.onnx
EMBED_MODEL=/models/w600k_mbf.onnx
SIMILARITY_THRESHOLD=0.45
VOTE_FRAMES=7

# Storage
DB_PATH=/data/db/watchman.sqlite3
